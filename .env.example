# LiteMind CLI configuration — copy to .env and edit.
# CLI flags (--backend / --model) always override these values.

# LiteMindUI backend URL
FASTAPI_URL=http://localhost:8000

# Default provider: ollama | openrouter | nim
DEFAULT_BACKEND=ollama

# Default model name
DEFAULT_MODEL=llama3.2

# Provider API base URL (override; usually auto-filled per provider in the TUI)
API_BASE=

# Provider API key (required for openrouter / nim)
API_KEY=

# HTTP timeouts (seconds)
CONNECT_TIMEOUT=5
READ_TIMEOUT=600

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
